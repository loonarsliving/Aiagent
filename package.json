{
  "name": "mkh-ai-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AI Operating System for PT Maha Karya Haluoleo — digital-employee background workers (marketing, ads, sales, finance, CEO assistant).",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo run dev --filter=dashboard",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "scheduler:dev": "tsx watch packages/scheduler/src/local-runner.ts",
    "mcp:dev": "tsx watch packages/mcp-server/src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "tsx": "^4.19.1",
    "vitest": "^2.1.3",
    "vite-tsconfig-paths": "^5.0.1"
  }
}
