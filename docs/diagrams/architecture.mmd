graph TD
    subgraph Trigger["Autonomous trigger (no UI)"]
        Cron[node-cron local-runner]
        HTTP["/api/cron/[moduleId] - future MK Connect webhook"]
    end

    Scheduler[packages/scheduler]

    subgraph Engine["packages/ai-engine"]
        Runner[runEmployeeTask]
        MI[Marketing Intelligence AI]
        MO[Marketing Operation AI]
        MA[Meta Ads AI]
        SS[Sales Supervisor AI]
        FA[Finance Analyst AI]
        CEO[CEO Assistant AI]
    end

    Memory[packages/memory - Knowledge Base]
    Notif[packages/notifications - Notification Engine]
    Security[packages/security - RBAC + Approval Gate]
    Connectors[packages/connectors - ports + mock adapters]
    DB[(packages/database - Repository)]
    MCP[packages/mcp-server - read only]

    Cron --> Scheduler
    HTTP -.future.-> Scheduler
    Scheduler --> Runner
    Runner --> MI & MO & MA & SS & FA & CEO

    MI --> Connectors
    MI --> Memory
    MO --> MI
    MO --> Notif
    MA --> Connectors
    MA --> Security
    MA --> Notif
    SS --> DB
    SS --> Notif
    FA --> DB
    CEO --> MI & MO & MA & SS & FA

    MI & MO & MA & SS & FA & CEO --> DB
    Memory --> DB
    Notif --> DB
    MCP --> DB
    MCP --> Engine

    Connectors -.mock only, blocked.-> MKConnect[MK Connect / mkh.haluoleo.id]

    style MKConnect fill:#3a1414,stroke:#f66,color:#f66
    style HTTP fill:#1a1a1a,stroke:#888,color:#888,stroke-dasharray: 5 5
