# ─────────────────────────────────────────────────────────────
# mkh-ai-os environment configuration
# Copy to .env.local (dashboard) / .env (scripts). Nothing here is
# required to run the system — DATA_MODE=dummy and all notification
# channels default to a no-op "dummy" adapter until you fill these in.
# ─────────────────────────────────────────────────────────────

# --- Data mode --------------------------------------------------
# "dummy"    = in-memory seeded fixtures, no external calls (default, safe)
# "supabase" = read/write a real Supabase project (requires vars below)
DATA_MODE=dummy

# --- Supabase (only needed when DATA_MODE=supabase) --------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Scheduler -----------------------------------------------------
# Shared secret required on /api/cron/* requests (Vercel Cron sends this
# as a Bearer token; also used by the local node-cron runner).
CRON_SECRET=change-me-in-production

# --- Retry strategy (every employee task run goes through this) ---------
# Total attempts including the first try. 1 = no retry.
MAX_RETRY_ATTEMPTS=3
# Base backoff in ms before a retry; doubles each attempt (1x, 2x, 4x, ...).
RETRY_BACKOFF_MS=200

# --- Notification channels (all optional; unset = channel stays dummy) ---
NOTIFY_CHANNEL_DEFAULT=dummy   # dummy | whatsapp | telegram | email | push

WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_BUSINESS_PHONE_ID=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=

PUSH_PROVIDER_API_KEY=

# --- Connectors (Modul 1 & 2 — all mocked until keys are supplied) ------
INSTAGRAM_GRAPH_TOKEN=
TIKTOK_API_TOKEN=
META_ADS_ACCESS_TOKEN=
META_ADS_ACCOUNT_ID=

# --- MK Connect (DO NOT SET until explicit integration instruction) -----
MK_CONNECT_BASE_URL=
MK_CONNECT_API_KEY=

# --- AI Provider (Sprint 2 — Reasoning Engine) ---------------------------
# Plug-and-play: gemini is the only implemented provider today; claude/
# openai/ollama are registered stubs for future work (see @mkh/ai-provider).
AI_PROVIDER=gemini

# Required when AI_PROVIDER=gemini. Get a key at https://aistudio.google.com/apikey
# NEVER commit a real key — this file is a template only (.env/.env.local are gitignored).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- AI reasoning tuning (all optional; defaults shown) ------------------
AI_TEMPERATURE=0.3
AI_MAX_OUTPUT_TOKENS=1024
AI_RETRY_ATTEMPTS=3
AI_RETRY_BACKOFF_MS=300
AI_TIMEOUT_MS=15000
AI_SAFETY_THRESHOLD=BLOCK_MEDIUM_AND_ABOVE
AI_RETRIEVAL_TOP_K=8
